{
  "id": "./?workspace=maps&demo=1",
  "name": "SAP Service \u00b7 Maps Demo",
  "short_name": "SAP Demo",
  "description": "Read-only SAP Service map demonstration. Private submissions are not available.",
  "start_url": "./?workspace=maps&demo=1",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#111b2e",
  "theme_color": "#1e2d53",
  "icons": [
    {
      "src": "./brand/map-app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./brand/map-app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./brand/map-app-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
