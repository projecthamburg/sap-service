{
  "name": "sap-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build-pdf.mjs --dev && node scripts/build-plan.mjs --dev && node scripts/build-admin.mjs --dev && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:audit": "node scripts/browser-audit.mjs",
    "test:devices": "node scripts/device-audit.mjs",
    "domscan": "node scripts/domscan.mjs",
    "blueprint": "node scripts/blueprint.mjs",
    "check": "node scripts/check.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:api": "node api/provision-aws.mjs",
    "evidence:map": "node scripts/evidence-map.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "amazon-cognito-identity-js": "6.3.22",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "puppeteer-core": "25.16.0"
  }
}
