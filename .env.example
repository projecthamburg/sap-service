# Local deployment credentials. Never import this file into browser code.
GITHUB_TOKEN=
AWS_BUSINESS_ACCESS_KEY_ID=
AWS_BUSINESS_SECRET_ACCESS_KEY=
SAP_AWS_REGION=ca-central-1
RESEND_API_KEY=
# Application secrets are generated into ignored .local/aws-service-secrets.json.
# CI receives them through encrypted repository secrets and uses AWS OIDC.
SAP_ADMIN_TOKEN=
SAP_RATE_SALT=
SAP_NOTIFICATION_FROM=SAP Service <sap-service@projecthamburg.com>
